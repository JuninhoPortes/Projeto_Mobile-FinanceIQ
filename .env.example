# Configuração pública do aplicativo; nunca colocar tokens ou credenciais aqui.
# Padrão: mock local. Backend demonstrativo: backend-simulated, somente em desenvolvimento.
# backend-real: aceita exclusivamente respostas reais, também só em desenvolvimento.
# Não ativa o backend nem rearma o piloto. Manter mock como padrão.
# Operação local sem editar este arquivo: npm run receipts:web (ou receipts:android).
# Backend separado: npm run receipts:backend; ver docs/receipts-local.md.
EXPO_PUBLIC_RECEIPT_ANALYSIS_MODE=mock

# URL compartilhada com os serviços HTTP existentes. Ajustar ao ambiente local.
# localhost serve para o navegador no mesmo computador; Android usa um endereço acessível pelo dispositivo.
EXPO_PUBLIC_API_URL=http://localhost:3000
