PORT=3000

# Mesmo projeto utilizado pelo Firebase Authentication do frontend.
FIREBASE_PROJECT_ID=

# Lista de UIDs separada por vírgulas; vazia nega todos. Não aceita wildcard.
RECEIPT_PILOT_UIDS=

# Credenciais via Application Default Credentials no servidor.
# Prefira identidade do ambiente. Se necessário, configure GOOGLE_APPLICATION_CREDENTIALS
# no ambiente do servidor para um arquivo protegido FORA do repositório.
# Não use FIREBASE_AUTH_EMULATOR_HOST nesta rota.

# Upload: ativação explícita apenas para piloto local com uma aplicação/processo.
# Produção permanece bloqueada até haver controle compartilhado aprovado.
RECEIPT_LIMITS_MODE=
# RECEIPT_LIMITS_MODE=local-single-process
RECEIPT_MAX_FILE_BYTES=10485760
RECEIPT_MAX_PDF_PAGES=3
RECEIPT_MAX_IMAGE_WIDTH=10000
RECEIPT_MAX_IMAGE_HEIGHT=10000
RECEIPT_MAX_IMAGE_PIXELS=20000000
RECEIPT_REQUESTS_PER_MINUTE=5
RECEIPT_REQUESTS_PER_DAY=30
RECEIPT_GLOBAL_CONCURRENCY=4
RECEIPT_UPLOAD_TIMEOUT_MS=20000
RECEIPT_VALIDATION_TIMEOUT_MS=8000
# Prazo total do consumidor; não ativa interpretação na rota.
RECEIPT_PROCESSING_TIMEOUT_MS=15000

# Modelo preservado; prazo do provedor precisa ser menor que o do consumidor.
RECEIPT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
RECEIPT_OPENAI_TIMEOUT_MS=10000
RECEIPT_OPENAI_MAX_OUTPUT_TOKENS=2048
# Chamadas reais desativadas. Não configurar chave nem habilitar nesta etapa.
RECEIPT_OPENAI_REAL_CALLS_ENABLED=false
# Declaração do orçamento aprovado do futuro teste, em centavos de USD.
# Não é um teto monetário executável. Ausência bloqueia real.
RECEIPT_OPENAI_TEST_BUDGET_USD_CENTS=
OPENAI_API_KEY=

# disabled preserva 501. simulated e real exigem desenvolvimento/piloto local.
# real também exige habilitação adicional, orçamento declarado, chave e prazos válidos.
RECEIPT_ANALYSIS_MODE=disabled
RECEIPT_SIMULATION_SCENARIO=success
RECEIPT_SIMULATION_DELAY_MS=250

# Entrada exclusiva do piloto: configuração temporária no processo, sem ler .env.
# Host deve ser exatamente 127.0.0.1; quotas/minuto, dia e concorrência devem ser 1.
RECEIPT_PILOT_HOST=127.0.0.1
# Diretório absoluto existente, protegido e persistente FORA do repositório.
# Ausente/inacessível ou marcador já existente bloqueia o piloto real.
RECEIPT_OPENAI_PILOT_LOCK_DIR=
