# EXEMPLO PÚBLICO. Copiar UMA VEZ para:
# %LOCALAPPDATA%\FinanceIQ\receipt-local\backend.env
# Nunca colocar o arquivo preenchido no repositório ou EXPO_PUBLIC_*.
# Habilitar ambas explicitamente no arquivo externo para usar o modo operacional.
RECEIPT_LOCAL_REAL_ENABLED=false
RECEIPT_OPENAI_REAL_CALLS_ENABLED=false
OPENAI_API_KEY=
FIREBASE_PROJECT_ID=
# UID único da conta de teste, obtido em Firebase Console > Authentication > Users.
RECEIPT_LOCAL_UID=
# Opcional se ADC já estiver disponível; caminho absoluto e externo ao repositório.
GOOGLE_APPLICATION_CREDENTIALS=
PORT=3002
RECEIPT_REQUESTS_PER_MINUTE=2
RECEIPT_REQUESTS_PER_DAY=5
RECEIPT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
RECEIPT_OPENAI_TIMEOUT_MS=25000
RECEIPT_PROCESSING_TIMEOUT_MS=30000
RECEIPT_OPENAI_MAX_OUTPUT_TOKENS=2048
